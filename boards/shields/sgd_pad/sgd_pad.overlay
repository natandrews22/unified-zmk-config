/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        diode-direction = "row2col";

        row-gpios = <
            &gpio0 17 (GPIO_ACTIVE_HIGH)
            &gpio0 20 (GPIO_ACTIVE_HIGH)
        >;

        col-gpios = <
            &gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
        >;
    };
};